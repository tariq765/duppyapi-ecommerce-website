# .env.example for FastAPI authentication backend

# PostgreSQL connection string (Neon)
DATABASE_URL=postgresql+asyncpg://username:password@db.neon.tech/your_database

# JWT secret key (use a strong random value)
JWT_SECRET_KEY=your-very-secret-key

# Access token expires in minutes (default 15)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token expires in days (default 30)
REFRESH_TOKEN_EXPIRE_DAYS=30

# Domain for HttpOnly cookies (e.g., .example.com)
COOKIE_DOMAIN=.example.com

# Enable debug mode (True/False)
DEBUG=False

# Google Gemini API Key for RAG Chatbot
GEMINI_API_KEY=your_gemini_api_key_here

